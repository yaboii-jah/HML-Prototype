{
  "name": "constructsync-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "build:deployment": "node scripts/check-toolchain.mjs --deployment && npm run build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "verify": "node scripts/verify.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "test:live": "node --experimental-strip-types scripts/live-integrations.mjs",
    "db:staging:preview": "node --env-file-if-exists=.env.local scripts/staging-database.mjs preview",
    "db:staging:apply": "node --env-file-if-exists=.env.local scripts/staging-database.mjs apply",
    "db:staging:types": "node --env-file-if-exists=.env.local scripts/staging-database.mjs types",
    "db:staging:check": "node --env-file-if-exists=.env.local scripts/staging-database.mjs check",
    "db:staging:auth:check": "node --env-file-if-exists=.env.local scripts/staging-database.mjs auth-check",
    "db:staging:auth:apply": "node --env-file-if-exists=.env.local scripts/staging-database.mjs auth-apply",
    "verify:db": "node scripts/verify-database.mjs",
    "auth:staging:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-staging-administrator.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "4.4.0",
    "google-auth-library": "^11.1.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@supabase/postgrest-typegen": "0.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
