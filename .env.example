# Copy to .env.local and add your Google AI Studio API key for MRF and quotation extraction. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Live Google Drive MRF archive. Required on Vercel; local development is enabled unless set to false.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Base64-encoded 32-byte key for encrypted resumable upload tickets.
GOOGLE_DRIVE_UPLOAD_TOKEN_KEY=
# Use a service account for an actual Shared Drive, or the OAuth values below for a shared My Drive folder.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
