# Copy to private .env.local. Staging Auth is supported; providers return in step 5.
# Optional later provider configuration. Never commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hosted staging for application Auth and explicitly targeted maintenance tooling.
SUPABASE_PROJECT_REF=gxphubtycnvhpgstruqb
NEXT_PUBLIC_SUPABASE_URL=https://gxphubtycnvhpgstruqb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only project API secret (sb_secret_), distinct from the maintenance PAT.
SUPABASE_SECRET_KEY=
# Canonical application origin; keep local development on 127.0.0.1.
APP_ORIGIN=http://127.0.0.1:3000
# Enable only after configuring and verifying the sender. Disposable CI uses Mailpit.
ACCOUNT_EMAIL_ENABLED=false
# Tooling only: a scoped token authorized for ConstructSync staging. Never use NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=
# Optional database password for remote CLI migration application.
SUPABASE_DB_PASSWORD=

# Later Google Drive archive configuration; foundation endpoints remain disabled.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Base64-encoded 32-byte key for encrypted resumable upload tickets.
GOOGLE_DRIVE_UPLOAD_TOKEN_KEY=
# Use a service account for an actual Shared Drive, or the OAuth values below for a shared My Drive folder.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
