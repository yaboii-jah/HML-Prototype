---
config:
  layout: elk
  theme: neutral
---
erDiagram
  direction TB
  accTitle: ConstructSync Core Entity Relationship Diagram
  accDescr: Ten core tables with expanded business fields and unlabeled Crow's Foot connectors.
  %% Proposed core business view, not the exhaustive physical database schema.
  %% Publication SVG uses a distinct header color per entity; no legend or visible diagram title.
  %% User header color: #BCD8F7
  APP_USER["User"] {
    uuid user_id PK
    string name
    string email
    string role
    boolean active
    datetime created_at
  }
  %% Project header color: #FFDD8A
  PROJECT["Project"] {
    uuid project_id PK
    string name
    string location
    decimal budget
    string drive_folder_id
  }
  %% Supplier header color: #BBE6CC
  SUPPLIER["Supplier"] {
    uuid supplier_id PK
    string name
    string contact
    string email
    string phone
    string tin
    string address
  }
  %% MRF header color: #DAC8F1
  MRF["MRF"] {
    uuid mrf_id PK
    uuid project_id FK
    uuid requested_by FK
    string reference
    date request_date
    string status
    string instructions
  }
  %% MRF Item header color: #F5C3D6
  MRF_ITEM["MRF Item"] {
    uuid item_id PK
    uuid mrf_id FK
    string material_name
    decimal quantity
    string unit
    date needed_date
    string location
    string remarks
  }
  %% Quotation header color: #BAE8E7
  QUOTATION["Quotation"] {
    uuid quotation_id PK
    uuid mrf_id FK
    uuid supplier_id FK
    string reference
    date quote_date
    string currency
    string review_status
    string source_reference
  }
  %% Purchase Order header color: #BBC5F4
  PURCHASE_ORDER["Purchase Order"] {
    uuid po_id PK
    uuid mrf_id FK
    uuid quotation_id FK
    uuid supplier_id FK
    string reference
    string payment_mode
    string status
    decimal gross_amount
    decimal net_payable
    string priority
    date planned_date
    date due_date
  }
  %% Verified Payment header color: #F7C99E
  PAYMENT["Verified Payment"] {
    uuid payment_id PK
    uuid po_id FK
    decimal amount
    string method
    string reference
    date payment_date
    datetime verified_at
    string proof_reference
  }
  %% Delivery header color: #DCEB9F
  DELIVERY["Delivery"] {
    uuid delivery_id PK
    uuid po_id FK
    string reference
    string leg
    date scheduled_date
    datetime received_at
    string status
    string destination
  }
  %% Inventory Movement header color: #D2D9E0
  INVENTORY_MOVEMENT["Inventory Movement"] {
    uuid movement_id PK
    uuid project_id FK
    uuid? delivery_id FK
    string material_name
    string unit
    string kind
    decimal quantity
    datetime occurred_at
  }
  APP_USER ||..o{ MRF : ""
  PROJECT ||..o{ MRF : ""
  MRF ||..o{ MRF_ITEM : ""
  MRF ||..o{ QUOTATION : ""
  SUPPLIER ||..o{ QUOTATION : ""
  MRF ||..o{ PURCHASE_ORDER : ""
  QUOTATION ||..o{ PURCHASE_ORDER : ""
  SUPPLIER ||..o{ PURCHASE_ORDER : ""
  PURCHASE_ORDER ||..o{ PAYMENT : ""
  PURCHASE_ORDER ||..o{ DELIVERY : ""
  PROJECT ||..o{ INVENTORY_MOVEMENT : ""
  DELIVERY |o..o{ INVENTORY_MOVEMENT : ""
