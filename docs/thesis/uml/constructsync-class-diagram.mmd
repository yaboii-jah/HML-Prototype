---
config:
  theme: neutral
  look: classic
  layout: dagre
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction TB

    class User {
        UUID id
        String name
        String email
        Role role
        Boolean active
        updateAccount()
        assignProject()
    }

    class Project {
        UUID id
        String name
        String location
        Decimal budget
        updateDetails()
        allocateBudget()
        getStockBalance()
    }

    class Supplier {
        UUID id
        String name
        String contact
        String phone
        String address
        getContactDetails()
    }

    class MRF {
        UUID id
        String reference
        Date requestDate
        String status
        String instructions
        submit()
        review(decision)
        revise()
    }

    class MRFItem {
        UUID id
        String materialName
        Decimal quantity
        String unit
        Date neededDate
        updateQuantity()
    }

    class Quotation {
        UUID id
        String reference
        Date quoteDate
        String reviewStatus
        finalize()
        calculateTotal()
    }

    class PurchaseOrder {
        UUID id
        String reference
        String status
        String paymentMode
        Decimal netPayable
        review(decision)
        issue()
        clearDelivery()
    }

    class VerifiedPayment {
        UUID id
        Decimal amount
        Date paymentDate
        DateTime verifiedAt
        String proofReference
        verify()
        void(reason)
    }

    class Delivery {
        UUID id
        String reference
        String leg
        Date scheduledDate
        String status
        schedule()
        dispatch()
        confirmReceipt()
    }

    class StockTransfer {
        UUID id
        String reference
        String status
        DateTime createdAt
        requestRelease()
        reviewRelease(decision)
        cancelUndispatched()
    }

    class InventoryMovement {
        UUID id
        String materialName
        String unit
        String kind
        Decimal quantity
        post()
    }

    User "1" -- "0..*" MRF
    User "0..*" -- "0..*" Project : assigned sites
    Project "1" -- "0..*" MRF
    MRF "1" *-- "0..*" MRFItem
    MRF "1" -- "0..*" Quotation
    Supplier "1" -- "0..*" Quotation
    MRF "1" -- "0..*" PurchaseOrder
    Quotation "1" -- "0..*" PurchaseOrder
    Supplier "1" -- "0..*" PurchaseOrder
    PurchaseOrder "1" -- "0..*" VerifiedPayment
    PurchaseOrder "0..1" -- "0..*" Delivery
    StockTransfer "0..1" -- "0..*" Delivery
    MRF "1" -- "0..*" StockTransfer
    Project "1" -- "0..*" StockTransfer : source
    Project "1" -- "0..*" StockTransfer : destination
    Project "1" -- "0..*" InventoryMovement
    Delivery "0..1" -- "0..*" InventoryMovement

    note for Delivery "{xor}: exactly one owner\nPurchaseOrder or StockTransfer"

%% Conceptual business operations; supporting classes remain outside the core view.
