flowchart TB
  %% Inter-site stock transfer
  %% Descriptive events identify entries; named process handoffs use off-page pentagons in publication exports.
  transferQuantities(["Materials allocated; for site transfer"])
  confirmSuitability["Procurement; Verify matching; descriptions & units"]
  proposeTransfer["Procurement; Recheck availability; Request source release"]
  sourceRelease{"Source Site; Personnel; Release decision?"}
  recordRelease["Source Site Personnel; Record released /; unreleased quantities"]
  resourcing["Unreleased quantities; Return to material; sourcing"]
  scheduleTransfer["Logistics; Schedule transfer trip"]
  dispatchTransfer["Logistics; Dispatch & deduct; source stock"]
  transferReceiving["Proceed to; destination receiving"]
  transferQuantities --> confirmSuitability
  confirmSuitability --> proposeTransfer
  proposeTransfer --> sourceRelease
  sourceRelease -->|"Reject"| resourcing
  sourceRelease -->|"Approve full / part"| recordRelease
  recordRelease -->|"If any"| resourcing
  recordRelease -->|"Released qty"| scheduleTransfer
  scheduleTransfer --> dispatchTransfer
  dispatchTransfer -->|"Dispatched trip"| transferReceiving
  classDef plain fill:#ffffff,stroke:#000000,color:#000000
  class transferQuantities,confirmSuitability,proposeTransfer,sourceRelease,recordRelease,resourcing,scheduleTransfer,dispatchTransfer,transferReceiving plain
