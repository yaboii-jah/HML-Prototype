flowchart TB
  %% Delivery, receiving and inventory
  %% Descriptive events identify entries; named process handoffs use off-page pentagons in publication exports.
  supplierReady(["Supplier delivery; cleared"])
  scheduleDelivery["Logistics; Schedule delivery; & dispatch"]
  deliveryRoute{"Delivery; destination?"}
  warehouseReceipt["Procurement; Receive at warehouse"]
  warehouseDocuments["Warehouse receipts; Proceed to; receipt review"]
  warehouseTransfer["Logistics; Forward to original site"]
  transferDispatched(["Site transfer dispatched"])
  siteReceipt["Site Personnel; Record accepted qty; and discrepancies"]
  postInventory["Site Personnel; Post accepted site stock"]
  siteDocuments["Site receipts; Proceed to; receipt review"]
  inventoryPosted(["Site stock updated"])
  transferShortage{"Transfer qty missing?"}
  noResourcing(["No resourcing needed"])
  shortageResourcing["Missing transfer quantities; Return to material; sourcing"]
  supplierReady --> scheduleDelivery
  scheduleDelivery --> deliveryRoute
  deliveryRoute -->|"Direct to site"| siteReceipt
  deliveryRoute -->|"Warehouse"| warehouseReceipt
  warehouseReceipt --> warehouseTransfer
  warehouseReceipt --> warehouseDocuments
  warehouseTransfer --> siteReceipt
  transferDispatched --> siteReceipt
  siteReceipt --> postInventory
  siteReceipt --> siteDocuments
  siteReceipt --> transferShortage
  transferShortage -->|"No"| noResourcing
  transferShortage -->|"Yes"| shortageResourcing
  postInventory --> inventoryPosted
  classDef plain fill:#ffffff,stroke:#000000,color:#000000
  class supplierReady,scheduleDelivery,deliveryRoute,warehouseReceipt,warehouseDocuments,warehouseTransfer,transferDispatched,siteReceipt,postInventory,siteDocuments,inventoryPosted,transferShortage,noResourcing,shortageResourcing plain
